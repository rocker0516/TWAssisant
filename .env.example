# 複製成 .env 後填入實際值。.env 不會進 git。

APP_ENV=development  # development / production

# ── PostgreSQL ──────────────────────────────
POSTGRES_HOST=127.0.0.1  # 不要用 localhost（Windows 會先試 IPv6 而卡住）
POSTGRES_PORT=5432
POSTGRES_DB=twassistant

# 資料寫入用（排程、抓取程式）
POSTGRES_USER=tw_owner
POSTGRES_PASSWORD=change-me

# 公開網站用，只能讀
POSTGRES_READONLY_USER=tw_reader
POSTGRES_READONLY_PASSWORD=change-me-too

# ── 資料來源 ────────────────────────────────
FINMIND_TOKEN=
