# --- secrets / 本機憑證（絕不入庫，避免備份洩漏 token）---
credentials.toml
backend/credentials.toml
.env
.env.*
!.env.example

# --- 本機資料庫（每日盤後重抓，可重建，不入庫）---
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.pkl
backend/data/*.log

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- macOS / IDE ---
.DS_Store
.vscode/
.idea/

# pipeline 執行 log（launchd 寫入）
backend/data/*.log
backend/data/*.bin

# 技能派工的工具狀態（只有每次 session 都會變的 UUID，不該進版控）
.sf/
